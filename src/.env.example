# Copy to .env (local) or add each line to Replit Secrets. NEVER commit real values.

# --- RunPod: invoice-reading AI model (GLM-OCR on a Serverless vLLM endpoint) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
EXTRACT_MODEL_NAME=zai-org/GLM-OCR
# Optional: any other OpenAI-compatible vision endpoint instead of RunPod
# EXTRACT_MODEL_URL=
# EXTRACT_MODEL_KEY=

# --- WhatsApp intake (optional; without these, use the in-app demo simulator) ---
WHATSAPP_WEBHOOK=0
WEBHOOK_PORT=5055
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_URL=
# Public address of the webhook, so the bot can send generated invoice PDFs back
PUBLIC_BASE_URL=
# META_VERIFY_TOKEN=
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
